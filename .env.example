NODE_ENV=development
# Comma-separated entity IDs. Entity IDs use lowercase letters, digits, and hyphens.
CONCUR_ENTITIES=us-uat,us-production,eu-uat,eu-production

# Outbound network mode for every Concur OAuth and API request.
# direct: ignore proxy environment variables and connect directly.
# proxy: use CONCUR_PROXY_URL when set; otherwise use HTTPS_PROXY/HTTP_PROXY
# inherited by the process or defined below. NO_PROXY is honored in env mode.
CONCUR_NETWORK_MODE=direct
# CONCUR_PROXY_URL=http://proxy.example.com:8080
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# All Concur credentials are server-side only. Do not prefix them with VITE_.
CONCUR_US_UAT_LABEL="US UAT"
CONCUR_US_UAT_BASE_URL=
CONCUR_US_UAT_CLIENT_ID=
CONCUR_US_UAT_CLIENT_SECRET=
CONCUR_US_UAT_REFRESH_TOKEN=

CONCUR_US_PRODUCTION_LABEL="US Production"
CONCUR_US_PRODUCTION_BASE_URL=
CONCUR_US_PRODUCTION_CLIENT_ID=
CONCUR_US_PRODUCTION_CLIENT_SECRET=
CONCUR_US_PRODUCTION_REFRESH_TOKEN=

CONCUR_EU_UAT_LABEL="EU UAT"
CONCUR_EU_UAT_BASE_URL=
CONCUR_EU_UAT_CLIENT_ID=
CONCUR_EU_UAT_CLIENT_SECRET=
CONCUR_EU_UAT_REFRESH_TOKEN=

CONCUR_EU_PRODUCTION_LABEL="EU Production"
CONCUR_EU_PRODUCTION_BASE_URL=
CONCUR_EU_PRODUCTION_CLIENT_ID=
CONCUR_EU_PRODUCTION_CLIENT_SECRET=
CONCUR_EU_PRODUCTION_REFRESH_TOKEN=

DATA_DIR=data
LOG_DIR=logs
LOG_LEVEL=info
